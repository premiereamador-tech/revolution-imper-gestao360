# ===== Banco de dados =====
DATABASE_URL=postgresql://revolution:revolution_dev@localhost:5432/revolution_imper
DATABASE_POOL_MAX=10

# ===== Aplicação =====
APP_URL=http://localhost:3000
SESSION_TTL_HOURS=12

# ===== Administrador inicial (usado apenas pelo seed; troque a senha!) =====
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@revolutionimper.com.br
ADMIN_PASSWORD=

# Senha dos usuários de demonstração (somente seed de demo). Vazio = gerada aleatoriamente e exibida no terminal.
DEMO_PASSWORD=

# ===== Storage (local | s3) =====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ===== Notificações (mock | smtp / mock | meta) =====
NOTIFY_EMAIL_DRIVER=mock
SMTP_URL=
NOTIFY_WHATSAPP_DRIVER=mock
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ===== Serviços brasileiros =====
CEP_PROVIDER=viacep

# ===== Rotinas agendadas (POST /api/cron/alertas com Authorization: Bearer) =====
CRON_SECRET=
